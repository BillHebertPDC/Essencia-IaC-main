# Somente para desenvolvimento local. Gere credenciais diferentes para qualquer ambiente compartilhado.
COMPOSE_PROJECT_NAME=studio-many-local
DOCKERHUB_USER=billhebertpdc
IMAGE_TAG=latest

# Endpoints locais
FRONTEND_PORT=5173
BACKEND_PORT=8080
WAHA_PORT=3000
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MYSQL_PORT=3307
API_BASE_URL=http://localhost:8080
CORS_ALLOWEDORIGINS=http://localhost:5173

# Credenciais locais de desenvolvimento
RABBITMQ_USERNAME=studio_local
RABBITMQ_PASSWORD=local-rabbitmq-only
WAHA_API_KEY=local-waha-api-key
WAHA_SESSION=default
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=local-waha-dashboard-only
WAHA_PRINT_QR=true
WHATSAPP_PROVIDER=waha

# MySQL local. O volume mysql_data mantém os dados entre reinicializações.
MYSQL_DATABASE=studiomanydb
MYSQL_USER=studio_local
MYSQL_PASSWORD=local-mysql-only
MYSQL_ROOT_PASSWORD=local-mysql-root-only
# Seed idempotente compativel com MySQL (carregado em todo boot sem duplicar).
SPRING_SQL_INIT_MODE=always
SPRING_SQL_INIT_DATA_LOCATIONS=classpath:data-mysql.sql
JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
JWT_VALIDITY=3600
