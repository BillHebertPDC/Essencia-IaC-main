%% Studio Essencia - diagrama em estilo architecture-beta (grupos, icones e servicos)
%% Kroki renderiza normalmente (validado); o GitHub usa o mesmo motor Mermaid.
%% A versao em flowchart classico (funciona em qualquer mermaid) esta em
%% infraestrutura-completa.mmd.

architecture-beta
    group internet(internet)[Internet e usuarios]
        service browser(internet)[Navegador - site 80 e API 8080] in internet
        service admin(lock)[Admin - SSH 22, UI Rabbit 15672, WAHA 3000] in internet
        service whats(internet)[WhatsApp Cloud API] in internet

    group aws(cloud)[AWS us-west-2]
        service eip(cloud)[Elastic IP unico - o failover o move] in aws
        service ssm(lock)[SSM Session Manager - LabInstanceProfile] in aws
        service s3(database)[S3 us-east-1 - anexos - fora do IaC] in aws

        group vpc(cloud)[VPC 10.20.0.0/16 - 6 security groups - 4 route tables] in aws

            group puba(cloud)[Subnet publica 10.20.1.0/24 - AZ-A] in vpc
                service gwa(server)[GATEWAY ATIVO EC2 t3.micro - Nginx 80 8080 15672 3000 - NAT - EIP] in puba

            group pubb(cloud)[Subnet publica 10.20.2.0/24 - AZ-B] in vpc
                service gws(server)[GATEWAY RESERVA t3.micro - Nginx + agente failover 15s x4] in pubb

            group pra(database)[Subnet privada 10.20.11.0/24 - AZ-A - RT default gateway] in vpc
                service m1(server)[MANAGER-1 t3.micro - Swarm manager - ingress - token 8081] in pra
                service db(server)[MYSQL-DATA t3.small - mysql 8.4 - 3306 overlay] in pra
                service ebsdb(database)[EBS gp3 8GiB Retain - /data/mysql] in pra

            group prb(database)[Subnet privada 10.20.12.0/24 - AZ-B] in vpc
                service m2(server)[MANAGER-2 t3.micro - Swarm manager] in prb
                service mq(server)[RABBITMQ-DATA t3.small - rabbitmq 4 mgmt - 5672 e 15672] in prb
                service ebsmq(database)[EBS gp3 8GiB Retain - /data/rabbitmq] in prb

            group prc(database)[Subnet privada 10.20.13.0/24 - AZ-C] in vpc
                service m3(server)[MANAGER-3 t3.micro - Swarm manager - quorum 2/3] in prc

            group wk(server)[ASG 2x app-worker t3.small - label role app - sem IP publico] in vpc
                service front(server)[React servido por Nginx - porta 80] in wk
                service back(server)[Spring Boot API - 8080 - JWT e Swagger] in wk
                service act(server)[actions-service Spring Boot - consome fila] in wk
                service waha(server)[WAHA - API WhatsApp - 3000] in wk

    browser:R --> L:eip
    eip:R --> L:gwa
    admin:R --> L:gwa

    gwa:B --> T:m1
    gwa:B --> T:m2
    gwa:B --> T:m3
    gws:R --> L:eip

    m1:B --> T:front
    m1:B --> T:back
    m1:B --> T:waha

    back:R --> L:db
    back:B --> T:mq
    act:B --> T:mq
    act:R --> L:waha
    waha:T --> B:whats
    back:T --> B:s3

    db:R --> L:ebsdb
    mq:R --> L:ebsmq

    gws:T --> B:gwa
