flowchart TB

    BRW["Navegador do usuario<br/>site http://EIP/ e API http://EIP:8080<br/>portas 80/8080 abertas a AllowedWebCidr (default 0.0.0.0/0)"]
    ADM["Estacao do administrador<br/>SSH 22, RabbitMQ UI 15672, WAHA 3000<br/>apenas AllowedAdminCidr /32"]
    EIP["Elastic IP unico<br/>criado e exportado (PublicIp) pela stack dos gateways<br/>movido pelo agente no failover"]
    WAP["WhatsApp (cloud API externa)"]
    NET["Internet<br/>Docker Hub, apt/get.docker.com, S3, WhatsApp<br/>acessados pelo cluster via NAT do gateway"]
    SSMN["AWS Systems Manager<br/>Session Manager / Run Command<br/>perfil LabInstanceProfile - fornecido pelo laboratorio,<br/>nao criado por estes templates"]
    S3["S3: bucket-studio-teste-essencia-comprovante<br/>us-east-1 - fotos/comprovantes<br/>externo ao IaC (nao criado pelas stacks)"]

    subgraph VPC["VPC studio-essencia-dev 10.20.0.0/16 - stack studio-network"]

        SGL["SECURITY GROUPS (anexados as interfaces dos nos)<br/>gateway-mgmt-sg: TCP 22 <- AdminCidr<br/>gateway-app-sg: 80,443,8080 <- WebCidr | 15672,3000 <- AdminCidr | 80 <- gateway-mgmt (health do agente) | ICMP. OBS: 443 liberado, mas o Nginx ainda nao tem listener TLS<br/>gateway-nat-sg: qualquer protocolo <- cluster-sg (trajego do NAT)<br/>cluster-sg: 22 <- gateway-mgmt | 80,8080,15672,3000 <- gateway-app | total <- proprio cluster (Swarm: 2377 TCP quorum, 7946 TCP/UDP gossip, 4789 UDP overlay VXLAN, 8081 token, portas dos servicos)<br/>database-sg: 3306 <- cluster-sg<br/>rabbitmq-sg: 5672 e 15672 <- cluster-sg"]
        IGW["Internet Gateway"]
        RTPUB["RT publica<br/>0.0.0.0/0 -> IGW"]
        NOTE9["Total em execucao: 9 EC2<br/>2 gateways + 3 managers + 2 workers + 2 nos de dados<br/>= limite de 9 instancias running do AWS Academy"]

        subgraph AZA["AZ-A"]
            subgraph SPA["subnet publica 10.20.1.0/24"]
                GWA["GATEWAY ATIVO - EC2 t3.micro, root 8GiB<br/>10.20.1.10 - Ubuntu 24.04<br/>NGINX: proxy 80/8080/15672/3000 -> managers<br/>envia Host com porta (http_host; corrige CORS)<br/>NAT: sysctl ip_forward + iptables MASQUERADE<br/>SGs: gateway-mgmt + gateway-nat + gateway-app"]
            end
            subgraph SPI["subnet privada 10.20.11.0/24"]
                RTA["RT privada-A<br/>0.0.0.0/0 -> ENI do gateway ativo"]
                M1["MANAGER-1 - EC2 t3.micro, root 20GiB<br/>10.20.11.10 - Docker Swarm manager (leader inicial)<br/>ingress routing mesh + token de join HTTP :8081<br/>servico systemd swarm-labeler (labels por hostname)<br/>SG: cluster-sg"]
                DBN["MYSQL - EC2 t3.small, root 20GiB<br/>10.20.11.20 - worker Swarm, label role=database<br/>container mysql:8.4 - porta 3306 so na overlay<br/>SGs: cluster-sg + database-sg"]
                EBSA[("EBS gp3 8GiB, DeletionPolicy Retain<br/>ext4 LABEL=studio-data em /data/mysql<br/>bind mount do container")]
                DBN --- EBSA
            end
        end

        subgraph AZB["AZ-B"]
            subgraph SPB["subnet publica 10.20.2.0/24"]
                GWS["GATEWAY RESERVA - EC2 t3.micro, root 8GiB<br/>10.20.2.10 - NGINX + NAT identicos ao ativo<br/>agente de failover (systemd): TCP 80 a cada 15s,<br/>4 falhas (~1min) move EIP + gateway-app SG + rotas<br/>failback manual (scripts/switch-gateway.ps1)<br/>SGs: gateway-mgmt + gateway-nat (sem app ate promover)"]
            end
            subgraph SP2["subnet privada 10.20.12.0/24"]
                RTB["RT privada-B<br/>0.0.0.0/0 -> ENI do gateway ativo"]
                M2["MANAGER-2 - EC2 t3.micro, root 20GiB<br/>10.20.12.10 - manager Swarm + ingress mesh<br/>SG: cluster-sg"]
                RBN["RABBITMQ - EC2 t3.small, root 20GiB<br/>10.20.12.20 - worker Swarm, label role=rabbitmq<br/>container rabbitmq:4-management<br/>AMQP 5672 interno | UI 15672 publicada no Swarm<br/>SGs: cluster-sg + rabbitmq-sg"]
                EBSB[("EBS gp3 8GiB, DeletionPolicy Retain<br/>ext4 LABEL=studio-data em /data/rabbitmq<br/>bind mount do container")]
                RBN --- EBSB
            end
        end

        subgraph AZC["AZ-C"]
            subgraph SP3["subnet privada 10.20.13.0/24"]
                RTC["RT privada-C<br/>0.0.0.0/0 -> ENI do gateway ativo"]
                M3["MANAGER-3 - EC2 t3.micro, root 20GiB<br/>10.20.13.10 - manager Swarm<br/>quorum 2/3 sobrevive a queda de 1 AZ<br/>SG: cluster-sg"]
            end
        end

        subgraph WK["Auto Scaling Group app-workers - RTs privadas A/B/C"]
            W1["app-worker-1 - EC2 t3.small, root 20GiB<br/>sem IP publico - saida pelo NAT<br/>worker Swarm, label role=app | SG cluster-sg"]
            W2["app-worker-2 - EC2 t3.small, root 20GiB<br/>sem IP publico - saida pelo NAT<br/>worker Swarm, label role=app | SG cluster-sg"]
            FRONT["studio-essencia-front<br/>REACT (build servido por Nginx no container)<br/>publicado :80 no Swarm ingress<br/>API_BASE_URL = http://EIP:8080 (do payload)"]
            BACK["studio-essencia-backend<br/>JAVA / SPRING BOOT - API REST :8080<br/>JWT, Swagger, uploads (volume docker backend_uploads)<br/>publica notificacoes no RabbitMQ"]
            ACT["studio-essencia-actions-service<br/>JAVA / SPRING BOOT - sem porta publicada<br/>consome fila de notificacao e chama o WAHA"]
            WAHC["waha - devlikeapro/waha<br/>API de WhatsApp (NOWEB) + dashboard :3000<br/>volume docker waha_instances"]
            WNOTE["O Swarm agenda esses 4 servicos entre os 2 workers<br/>(constraint node.labels.role == app).<br/>Rede overlay: studio-network com aliases mysql, rabbitmq, waha,<br/>studio-essencia-backend, studio-essencia-front. Managers publicam as portas e roteiam ate os containers (routing mesh)"]
        end
    end

    subgraph CFN["Origem dos recursos - CloudFormation (nomes do repo: studio-*; na subida manual atual: nat1 / gat1 / clu1)"]
        SN["studio-network = 01-network.yml<br/>VPC, 5 sub-redes, IGW, 4 route tables, 6 security groups"]
        SGW["studio-gateway = 02-gateway.yml<br/>EIP + 2 instancias gateway + rotas default das privadas<br/>Nginx/NAT via user-data + agente de failover<br/>export: GatewayStackName-PublicIp"]
