%% Studio Essencia - visao completa da infraestrutura (AWS us-west-2)
%% Fontes: 01-network.yml, 02-gateway.yml, 03-cluster.yml, swarm/studio-essencia-stack-placement.yml

flowchart TB

    BRW["Navegador / usuario final<br/>chama http://EIP/ (site) e http://EIP:8080 (API)<br/>liberado para AllowedWebCidr (default 0.0.0.0/0)"]
    ADM["Estacao do administrador<br/>SSH 22, RabbitMQ UI 15672, WAHA 3000<br/>liberado apenas para AllowedAdminCidr /32"]
    EIP["Elastic IP unico (EIP)<br/>criado e exportado pela stack studio-gateway<br/>movido no failover"]
    WA["WhatsApp (cloud API externa)"]
    SSMN["AWS Systems Manager<br/>Session Manager / Run Command<br/>via LabInstanceProfile (todos os nos)"]
    S3["S3: bucket-studio-teste-essencia-comprovante<br/>us-east-1 - fotos/comprovantes<br/>(criado fora deste IaC)"]

    subgraph VPC["VPC studio-essencia-dev-vpc - 10.20.0.0/16 - stack studio-network"]

        IGW["Internet Gateway (igw)"]
        PRT["RT publica: 0.0.0.0/0 -> IGW<br/>associada as 2 sub-redes publicas"]
        PRTS["RTs privadas A/B/C (1 por AZ)<br/>0.0.0.0/0 -> ENI do gateway ATIVO<br/>reescritas pelo agente no failover"]
        SGDEF["SECURITY GROUPS<br/>gateway-mgmt-sg: 22 <- AdminCidr<br/>gateway-app-sg: 80,443,8080 <- WebCidr | 15672,3000 <- AdminCidr<br/>gateway-nat-sg: tudo <- cluster-sg<br/>cluster-sg: 22 <- gateway-mgmt | 80,8080,15672,3000 <- gateway-app | trafego total entre si (Swarm 2377/7946/4780, token 8081, dados)<br/>database-sg: 3306 <- cluster-sg<br/>rabbitmq-sg: 5672 e 15672 <- cluster-sg"]

        subgraph AZA["Availability Zone A"]
            subgraph SPA["subnet publica 10.20.1.0/24"]
                GWA["EC2 t3.micro root 8GiB - GATEWAY ATIVO 10.20.1.10<br/>Ubuntu 24.04 | NGINX + NAT (iptables MASQUERADE)<br/>Nginx: 80/8080/15672/3000 -> managers (Host com porta)<br/>SGs: gateway-mgmt + gateway-nat + gateway-app (publico)<br/>recebe o EIP"]
            end
            subgraph SPI["subnet privada 10.20.11.0/24"]
                M1["EC2 t3.micro root 20GiB - MANAGER-1 10.20.11.10<br/>Docker Swarm manager (leader inicial)<br/>ingress routing mesh + token join HTTP :8081<br/>SG cluster-sg"]
                DBN["EC2 t3.small root 20GiB - MYSQL 10.20.11.20<br/>worker Swarm label role=database<br/>container mysql:8.4 - 3306 so na overlay<br/>EBS gp3 8GiB DeletionPolicy Retain em /data/mysql<br/>SGs cluster-sg + database-sg"]
            end
        end

        subgraph AZB["Availability Zone B"]
            subgraph SPB["subnet publica 10.20.2.0/24"]
                GWS["EC2 t3.micro root 8GiB - GATEWAY RESERVA 10.20.2.10<br/>Ubuntu 24.04 | NGINX + NAT iguais ao ativo<br/>agente de failover: TCP 80 a cada 15s, 4 falhas=1min<br/>promove: move EIP + gateway-app SG + rotas privadas<br/>SGs gateway-mgmt + gateway-nat (sem app ate promover)"]
            end
            subgraph SP2["subnet privada 10.20.12.0/24"]
                M2["EC2 t3.micro - MANAGER-2 10.20.12.10<br/>Swarm manager + ingress mesh<br/>SG cluster-sg"]
                RBN["EC2 t3.small - RABBITMQ 10.20.12.20<br/>worker Swarm label role=rabbitmq<br/>container rabbitmq:4-management<br/>5672 AMQP interno | 15672 UI na overlay<br/>EBS gp3 8GiB Retain em /data/rabbitmq<br/>SGs cluster-sg + rabbitmq-sg"]
            end
        end

        subgraph AZC["Availability Zone C"]
            subgraph SP3["subnet privada 10.20.13.0/24"]
                M3["EC2 t3.micro - MANAGER-3 10.20.13.10<br/>Swarm manager (quorum 2/3 sobrevive a 1 AZ)<br/>SG cluster-sg"]
            end
        end

        WKS["Auto Scaling Group app-workers - 2x t3.small root 20GiB<br/>espalhados pelas 3 sub-redes privadas, sem IP publico<br/>worker Swarm label role=app | SG cluster-sg<br/>containers: studio-essencia-front (REACT servido por nginx, :80)<br/>studio-essencia-backend (SPRING BOOT API/JWT, :8080)<br/>studio-essencia-actions-service (SPRING BOOT consumer fila, sem porta)<br/>waha (devlikeapro/waha API WhatsApp, :3000)<br/>volumes docker: backend_uploads, waha_instances"]
        OVL["Rede overlay do Swarm: studio-network<br/>aliases DNS: mysql, rabbitmq, waha, studio-essencia-backend, front"]

        SGDEF -.- VPCNOTE[" "]
        M1 --- OVL
        M2 --- OVL
        M3 --- OVL
        WKS --- OVL
        DBN --- OVL
        RBN --- OVL
    end

    BRW -->|"HTTP 80 / 8080"| EIP
    ADM -->|"SSH 22 + UIs 15672/3000"| EIP
    EIP --> GWA
    GWA -->|"proxy 80 frontend"| M1
    GWA -->|"proxy 8080 API"| M2
    GWA -->|"proxy 15672 + 3000"| M3
    PRT --- IGW
    PRTS -->|"saida NAT dos nos privados"| GWA
    GWA --> IGW
    GWS -. "monitora TCP :80<br/>e promove-se no failover" .-> GWA
    DBN ---|"EBS gp3 Retain"| EBSA[("volume /data/mysql")]
    RBN ---|"EBS gp3 Retain"| EBSB[("volume /data/rabbitmq")]
    OVL -->|"3306 JDBC"| DBN
    OVL -->|"5672 AMQP publish/consume"| RBN
    OVL -->|"REST 3000"| WKS
    WKS -->|"NOWEB"| WA
    WKS -->|"upload/download"| S3
    GWA -.-> SSMN
    M1 -.-> SSMN
