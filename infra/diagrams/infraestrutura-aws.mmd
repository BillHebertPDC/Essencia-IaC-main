%% Studio Essencia - diagrama estilo AWS Architecture Icons (Mermaid architecture-beta)
%% Refs: https://mermaid.ai/open-source/syntax/architecture.html (sintaxe architecture-beta)
%%       https://mermaid.ai/docs/icons/aws (icones AWS, codigo "aws:arch-*")
%%       https://aws.amazon.com/architecture/icons/ (nomes oficiais dos icones)
%% ICONES AWS APARECEM no Mermaid Chart (app ou plugin VS Code), onde o pack "aws"
%% esta registrado. Em GitHub/kroki/mermaid.live o layout renderiza mas os icones
%% aws: podem aparecer vazios (validado: o SVG do kroki nao embute as imagens).
%% VERSAO UNIVERSAL (flowchart, icones genericos): infraestrutura-completa.mmd.
%% Codigo de icone que nao bater com o picker do Mermaid Chart: troque pelo nome
%% sugerido no editor - icone e rotulo nao alteram a estrutura do diagrama.

architecture-beta
    group mundo(internet)[Internet e usuarios]
        service browser(aws:arch-mobile-users)[Usuarios - site 80 e API 8080] in mundo
        service admin(aws:arch-user)[Admin - SSH 22, UIs 15672 e 3000] in mundo
        service whats(internet)[WhatsApp Cloud API] in mundo

    group nuvem(cloud)[AWS us-west-2]
        service eip(aws:arch-vpc-elastic-network-interface)[Elastic IP unico - failover o move] in nuvem
        service ssm(aws:arch-aws-systems-manager)[Systems Manager - Session Manager] in nuvem
        service s3(aws:arch-amazon-s3)[S3 us-east-1 - anexos - fora do IaC] in nuvem

        group vpc(aws:arch-amazon-vpc)[VPC 10.20.0.0/16 - 4 route tables - 6 security groups] in nuvem

            group puba(aws:arch-amazon-vpc)[subnet publica 10.20.1.0/24 - AZ-A] in vpc
                service gwa(aws:arch-amazon-ec2)[GATEWAY ATIVO EC2 t3.micro - Nginx 80/8080/15672/3000 - NAT - EIP] in puba

            group pubb(aws:arch-amazon-vpc)[subnet publica 10.20.2.0/24 - AZ-B] in vpc
                service gws(aws:arch-amazon-ec2)[GATEWAY RESERVA EC2 t3.micro - Nginx - agente failover 15s x4] in pubb

            group pra(aws:arch-amazon-vpc)[subnet privada 10.20.11.0/24 - RT default - AZ-A] in vpc
                service m1(aws:arch-amazon-ec2)[MANAGER-1 EC2 t3.micro - Swarm manager - ingress - token 8081] in pra
                service db(aws:arch-amazon-rds)[MYSQL-DATA EC2 t3.small - container mysql 8.4 - 3306 overlay] in pra
                service ebsdb(aws:arch-amazon-elastic-block-store)[EBS gp3 8GiB Retain - /data/mysql] in pra

            group prb(aws:arch-amazon-vpc)[subnet privada 10.20.12.0/24 - RT default - AZ-B] in vpc
                service m2(aws:arch-amazon-ec2)[MANAGER-2 EC2 t3.micro - Swarm manager] in prb
                service mq(aws:arch-amazon-mq)[RABBITMQ-DATA EC2 t3.small - rabbitmq 4 - 5672 e 15672] in prb
                service ebsmq(aws:arch-amazon-elastic-block-store)[EBS gp3 8GiB Retain - /data/rabbitmq] in prb

            group prc(aws:arch-amazon-vpc)[subnet privada 10.20.13.0/24 - RT default - AZ-C] in vpc
                service m3(aws:arch-amazon-ec2)[MANAGER-3 EC2 t3.micro - Swarm manager - quorum 2/3] in prc

            group wk(aws:arch-auto-scaling)[ASG 2x app-worker EC2 t3.small - label role app - sem IP publico] in vpc
                service front(server)[front - REACT servido por Nginx - 80] in wk
                service back(server)[backend - SPRING BOOT API - 8080 - JWT] in wk
                service act(server)[actions-service - SPRING BOOT - consome fila] in wk
                service waha(server)[WAHA - API WhatsApp - dashboard 3000] in wk

    browser:R --> L:eip
    admin:R --> L:eip
    eip:R --> L:gwa

    gwa:B --> T:m1
    gwa:B --> T:m2
    gwa:B --> T:m3

    gws:R --> L:eip
    gws:B --> T:gwa

    m1:B --> T:front
    m1:B --> T:back
    m1:B --> T:waha

    back:R --> L:db
    back:B --> T:mq
    act:B --> T:mq
    act:R --> L:waha
    waha:T --> B:whats
    back:T --> B:s3

    db:R --> L:ebsdb
    mq:R --> L:ebsmq
